<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="YHMIS.AvaloniaUI.Mobile.Views.Login.LoginView"
            xmlns:vm="using:YHMIS.AvaloniaUI.ViewModels.Login"
            x:DataType="vm:LoginViewModel"
            Background = "White">

    <UserControl.Styles>
        <Style Selector="TextBox.LoginInput">
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#B9C4CA" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#66767F" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style Selector="TextBox.LoginInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#3FA39C" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#1F6F6B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3FA39C" />
        </Style>

        <Style Selector="Button.PrimaryButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1F6F6B" />
        </Style>
    </UserControl.Styles>

    <Grid Background="White"
        RowDefinitions="*,Auto,*">

        <StackPanel Grid.Row="1"
                    Margin="22.0">

            <StackPanel Orientation="Horizontal"
                        Spacing="5">

                    <Border Width="12"
                            Height="12"
                            CornerRadius="3"
                            Background="#1F6F6B"/>
                <TextBlock Text="YHMIS"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#263238"/>
            </StackPanel>

            <TextBlock Text="Frase"
                       FontSize="10"
                      Foreground="#52636D"
                      Margin="0,2,0,0"/>
                    
                <StackPanel Margin="0,20,0,0"
                            Spacing="10">

                    <StackPanel Spacing="5">
                        <TextBlock Text="Correo"
                                    FontSize="9"
                                    Foreground="#52636D"/>

                        <TextBox Classes="LoginInput"
                                Watermark="Ingrese su correo"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Contraseña"
                                    FontSize="9"
                                    Foreground="#52636D"/>
                                    
                        <TextBox Classes="LoginInput"
                                Watermark="Ingrese su contraseña"/>
                        </StackPanel>
                            <Button Classes="PrimaryButton"
                                    Content="Entrar"
                                    Margin="0,2,0,0"/>
                        
                </StackPanel>
                
        </StackPanel>
        

    </Grid>


</UserControl>
